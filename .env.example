# Copy this file to .env and fill in your key to enable real AI prioritization.
# Without it, the backend falls back to a rule-based priority assignment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
API_PORT=3001

# Only needed when building the Android app: point it at a backend the phone
# can reach. Android emulator -> host machine: http://10.0.2.2:3001
# Physical device on the same Wi-Fi -> http://<your-computer-LAN-IP>:3001
VITE_API_BASE_URL=
