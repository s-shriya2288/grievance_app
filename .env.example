# Copy this file to .env and fill in your values.

# --- Database (required) ---
# PostgreSQL connection string. Get a free instance from Supabase or Neon —
# see the "Database setup" section in README.md for step-by-step instructions.
DATABASE_URL=

# --- Auth (required) ---
# Any long random string works, e.g. `openssl rand -base64 48`. Keep it secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- File uploads (optional) ---
# Enables grievance attachment uploads via Vercel Blob. Without it, the file
# input on the New Grievance form still shows, but uploads fail with a clear
# "not configured" error and grievances can still be submitted without one.
# Get a token from a Vercel project's Storage tab (create a Blob store there).
BLOB_READ_WRITE_TOKEN=

# --- Email (optional) ---
# Without this, password-reset OTPs are logged to the server console and
# echoed back in the API response (devOtp) instead of emailed, so the app
# still works end-to-end without an email provider.
# Get a key from Brevo (brevo.com) → Settings → SMTP & API → API Keys.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@yourdomain.com
BREVO_FROM_NAME=Dalmia Rajgangpur Grievance Portal
APP_URL=http://localhost:5173

# --- AI triage (optional) ---
# Without this, the backend falls back to a rule-based priority assignment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
API_PORT=3001

# Only needed when building the Android app: point it at a backend the phone
# can reach. Android emulator -> host machine: http://10.0.2.2:3001
# Physical device on the same Wi-Fi -> http://<your-computer-LAN-IP>:3001
VITE_API_BASE_URL=
